                  "descendants": {
                    "YzlvI": {
                      "content": "ABOUT LAUREN"
                    }
                  }
                },
                {
                  "type": "text",
                  "id": "R0fAS1",
                  "name": "heroHeadline",
                  "fill": "$foreground-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Cleaning, but the way it should have always been done.",
                  "lineHeight": 1.05,
                  "fontFamily": "$font-heading",
                  "fontSize": 64,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "EXtQT",
                  "name": "heroIntro",
                  "fill": "$foreground-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Pure Home is a small, considered cleaning practice serving discerning homeowners and commercial spaces. We use only 100% non-toxic, plant-based products — sourced from small batch makers we know by name — because what you breathe at home matters as much as what you eat.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
